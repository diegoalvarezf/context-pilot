{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "npx -y context-pilot@0.7.1 on prompt --hook --agent claude", "timeout": 60 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep",
        "hooks": [
          { "type": "command", "command": "npx -y context-pilot@0.7.1 on search --hook --agent claude", "timeout": 60 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "npx -y context-pilot@0.7.1 on edit --hook --agent claude", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "npx -y context-pilot@0.7.1 on stop --hook --agent claude", "timeout": 60 }
        ]
      }
    ]
  }
}
